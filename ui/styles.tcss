Screen {
    background: #111111;
    color: #f5f5f5;
}

#header {
    height: 3;
    background: #1b1b1b;
    color: #ffffff;
    padding: 0 2;
    layout: horizontal;
}

#header-title {
    width: 1fr;
    text-style: bold;
}

#header-mode {
    width: 20;
    color: #9aa0a6;
}

#header-source {
    width: 18;
    color: #9aa0a6;
}

#content {
    height: 1fr;
}

#sidebar {
    width: 30;
    background: #161616;
    border: round #2a2a2a;
    padding: 1 2;
}

#main-pane {
    padding: 1 2;
    height: 1fr;
}

#partial-panel {
    height: 9;
    margin-bottom: 1;
}

#final-panel {
    height: 1fr;
}

#footer {
    height: 3;
    background: #1b1b1b;
    color: #9aa0a6;
    padding: 1 2;
}

.section-title {
    color: #9aa0a6;
    text-style: bold;
    margin-bottom: 1;
}

#status-label {
    color: #ff5d73;
    text-style: bold;
    margin-bottom: 1;
}

#source-label, #mode-label, #copy-label {
    color: #cccccc;
    margin-bottom: 1;
}

#input-meter {
    margin-top: 1;
}
